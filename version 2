cat << 'EOF' > docker-compose.yml
services:
  ctf_web:
    build: ./plataforma-web
    container_name: ctf_web_platform
    ports:
      - "8080:3000"

  web_challenge:
    image: nginx:alpine
    container_name: ctf_http
    ports:
      - "80:80"
    volumes:
      - ./html:/usr/share/nginx/html:ro

  ftp_challenge:
    image: fauria/vsftpd
    container_name: ctf_ftp
    ports:
      - "21:21"
      - "20:20"
      - "21100-21110:21100-21110"
    environment:
      FTP_USER: anonymous
      FTP_PASS: anonymous
      ANONYMOUS_ENABLE: "YES"
      PASV_ENABLE: "YES"
      PASV_MIN_PORT: 21100
      PASV_MAX_PORT: 21110
      PASV_ADDRESS: 0.0.0.0
    volumes:
      - ./ftp:/home/vsftpd/anonymous:ro

  linux_challenge:
    build: ./ssh
    container_name: ctf_linux_ssh
    ports:
      - "2222:22"
EOF


cat << 'EOF' > plataforma-web/server.js
const express = require('express');
const sqlite3 = require('sqlite3').verbose();
const path = require('path');

const app = express();
const PORT = 3000;

app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

const db = new sqlite3.Database('./ctf.db');

db.serialize(() => {
    db.run(`CREATE TABLE IF NOT EXISTS challenges (
        id TEXT PRIMARY KEY, title TEXT, category TEXT, points INTEGER, description TEXT, flag TEXT
    )`);

    const challenges = [
        ["reto_01", "01. Dirección Física (MAC)", "Redes", 50, "Ejecuta 'ipconfig /all' en tu máquina Windows y encuentra la Dirección Física de tu tarjeta activa. Formato: FLAG{XX-XX-XX-XX-XX-XX} o FLAG{XX:XX:XX:XX:XX:XX}.", "DYNAMIC_MAC"],
        ["reto_02", "02. Servidor DNS", "Redes", 50, "Usando la salida del comando anterior, ingresa la IP del servidor DNS configurado. Formato: FLAG{X.X.X.X}.", "DYNAMIC_IP"],
        ["reto_03", "03. Archivos Ocultos", "Linux", 100, "Conéctate por SSH (puerto 2222, usuario: alumno, pass: cisco123) y localiza el archivo oculto en el home (~/.flag1.txt).", "FLAG{hidden_files_mastered}"],
        ["reto_04", "04. Filtrado con Grep", "Linux", 100, "Inspecciona el archivo '/var/log/system_audit.log' en la MV Linux y filtra la línea con la palabra FLAG.", "FLAG{grep_text_filtering_2026}"],
        ["reto_05", "05. Permisos de Archivos", "Linux", 100, "Inspecciona los permisos del archivo '/opt/secret/confidential.txt' y lee su contenido.", "FLAG{linux_permissions_ok}"],
        ["reto_06", "06. FTP Anónimo", "Servicios", 150, "Conéctate de forma anónima al servicio FTP (puerto 21) del servidor y lee el archivo 'welcome.txt'.", "FLAG{ftp_anonymous_access_granted}"],
        ["reto_07", "07. Inspección HTTP", "Servicios", 150, "Inspecciona el código fuente HTML del servidor web (puerto 80) para encontrar la flag oculta.", "FLAG{http_source_code_inspection}"],
        ["reto_08", "08. Acceso SSH Final", "Servicios", 200, "Ingresa vía SSH con el usuario 'alumno' y lee el archivo '/home/alumno/final_flag.txt'.", "FLAG{ssh_secure_shell_connected}"]
    ];

    const stmt = db.prepare(`INSERT OR REPLACE INTO challenges VALUES (?, ?, ?, ?, ?, ?)`);
    challenges.forEach(c => stmt.run(c));
    stmt.finalize();
});

app.get('/api/challenges', (req, res) => {
    db.all(`SELECT id, title, category, points, description FROM challenges`, [], (err, rows) => {
        if (err) return res.status(500).json({ error: err.message });
        res.json(rows);
    });
});

app.post('/api/submit', (req, res) => {
    const { challengeId, flagInput } = req.body;
    const cleanFlag = (flagInput || '').trim();

    if (!cleanFlag) return res.json({ success: false, message: "Debes ingresar una flag." });

    if (challengeId === "reto_01") {
        const macRegex = /^FLAG\{([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})\}$/;
        if (macRegex.test(cleanFlag)) {
            return res.json({ success: true, message: "¡Correcto! Dirección física (MAC) identificada." });
        } else {
            return res.json({ success: false, message: "Formato de MAC inválido. Usa: FLAG{XX-XX-XX-XX-XX-XX}" });
        }
    }

    if (challengeId === "reto_02") {
        const ipRegex = /^FLAG\{(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}\}$/;
        if (ipRegex.test(cleanFlag)) {
            return res.json({ success: true, message: "¡Correcto! Servidor DNS identificado." });
        } else {
            return res.json({ success: false, message: "Formato de IP inválido. Usa: FLAG{192.168.1.1}" });
        }
    }

    db.get(`SELECT flag, points FROM challenges WHERE id = ?`, [challengeId], (err, row) => {
        if (err || !row) return res.status(404).json({ success: false, message: "Reto no encontrado." });
        if (row.flag.trim() === cleanFlag) {
            res.json({ success: true, message: `¡Correcto! Has ganado ${row.points} puntos.` });
        } else {
            res.json({ success: false, message: "Flag incorrecta. Inténtalo de nuevo." });
        }
    });
});

app.listen(PORT, '0.0.0.0', () => console.log(`CTF listo en puerto ${PORT}`));
EOF


cat << 'EOF' > plataforma-web/public/app.js
let totalScore = 0;
const solvedChallenges = new Set();
document.addEventListener('DOMContentLoaded', fetchChallenges);

async function fetchChallenges() {
    const res = await fetch('/api/challenges');
    const challenges = await res.json();
    const container = document.getElementById('challenges-container');
    container.innerHTML = '';
    challenges.forEach(c => {
        const card = document.createElement('div');
        card.className = `card ${solvedChallenges.has(c.id) ? 'solved' : ''}`;
        card.id = `card-${c.id}`;
        card.innerHTML = `
            <span class="badge">${c.category} - ${c.points} pts</span>
            <h3>${c.title}</h3>
            <p>${c.description}</p>
            <div class="input-group">
                <input type="text" id="input-${c.id}" placeholder="FLAG{...}" ${solvedChallenges.has(c.id) ? 'disabled' : ''}>
                <button onclick="submitFlag('${c.id}', ${c.points})" ${solvedChallenges.has(c.id) ? 'disabled' : ''}>Enviar</button>
            </div>
            <div class="result-msg" id="msg-${c.id}"></div>
        `;
        container.appendChild(card);
    });
}

async function submitFlag(id, points) {
    const input = document.getElementById(`input-${id}`);
    const msgDiv = document.getElementById(`msg-${id}`);
    const flagInput = input.value;
    if (!flagInput) return;
    const res = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ challengeId: id, flagInput })
    });
    const data = await res.json();
    if (data.success) {
        msgDiv.className = 'result-msg success';
        msgDiv.textContent = data.message;
        if (!solvedChallenges.has(id)) {
            solvedChallenges.add(id);
            totalScore += points;
            document.getElementById('total-score').textContent = totalScore;
            document.getElementById(`card-${id}`).classList.add('solved');
            input.disabled = true;
        }
    } else {
        msgDiv.className = 'result-msg error';
        msgDiv.textContent = data.message;
    }
}
EOF

